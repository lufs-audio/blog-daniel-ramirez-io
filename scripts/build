#!/usr/bin/env bash
# Portable build step (website-portability contract). Builds ONCE into dist/.
# The Obsidian -> content ingestion is a SEPARATE step the author runs locally
# (sync_obsidian-to-astro.sh); CI only ever sees committed Markdown.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [ -f package-lock.json ]; then
  npm ci
else
  npm install
fi

npm run build

test -s dist/index.html || { echo "build: dist/index.html missing or empty"; exit 1; }

# Stamp build provenance INTO the artifact, so the bytes we serve can be traced
# back to the commit they came from with a single request (GET /build.json).
# This lives here rather than in the workflow so every build path — CI, local,
# or a future host — produces a self-describing artifact. scripts/verify then
# recomputes the digest and fails closed if the stamp doesn't match.
python3 scripts/stamp-provenance

echo "build: ok"
