#!/usr/bin/env python3
"""
Portable artifact verifier (website-portability contract). Proves the built
dist/ is correct rather than trusting the build's exit code. Emits
verification.json and fails closed. This is the honest gate the old Hugo flow
lacked.

Checks:
  - index_exists         : dist/index.html present and non-empty
  - required_routes      : every route in site/routes.txt resolves in dist/
  - url_parity           : every published post's Hugo-slug URL exists in dist/
  - asset_size_budget    : no file exceeds runtime.max_asset_bytes in site.yaml
  - secret_scan          : no obvious private-key material in the artifact
"""
import json
import os
import re
import sys
import pathlib

REPO = pathlib.Path(__file__).resolve().parent.parent
DIST = REPO / "dist"
CONTENT_POSTS = REPO / "src" / "content" / "posts"
ROUTES_FILE = REPO / "site" / "routes.txt"
MAX_ASSET_BYTES = 26214400  # mirror site.yaml runtime.max_asset_bytes

checks = []


def add(cid, ok, **extra):
    checks.append({"id": cid, "status": "passed" if ok else "failed", **extra})
    return ok


def hugo_slug(title: str) -> str:
    s = title.lower()
    s = re.sub(r"[^0-9a-zÀ-￿]+", "-", s)  # non-alphanumeric -> hyphen
    return s.strip("-")


def route_to_file(route: str) -> pathlib.Path:
    route = route.strip()
    if route.endswith("/"):
        return DIST / route.strip("/") / "index.html"
    return DIST / route.lstrip("/")


ok_all = True

# index_exists
idx = DIST / "index.html"
ok_all &= add("index_exists", idx.is_file() and idx.stat().st_size > 0)

# required_routes
missing_routes = []
if ROUTES_FILE.is_file():
    for line in ROUTES_FILE.read_text().splitlines():
        r = line.strip()
        if not r or r.startswith("#"):
            continue
        if not route_to_file(r).is_file():
            missing_routes.append(r)
ok_all &= add("required_routes", not missing_routes, missing=missing_routes)

# url_parity: each non-draft post's /posts/<slug>/ exists
missing_posts = []
if CONTENT_POSTS.is_dir():
    for md in CONTENT_POSTS.glob("*.md"):
        text = md.read_text(encoding="utf-8")
        m = re.search(r"^---\s*\n(.*?)\n---", text, re.S)
        fm = m.group(1) if m else ""
        title_m = re.search(r"^title:\s*(.+?)\s*$", fm, re.M)
        draft_m = re.search(r"^draft:\s*(true|false)\s*$", fm, re.M)
        if not title_m:
            continue
        if draft_m and draft_m.group(1) == "true":
            continue
        slug = hugo_slug(title_m.group(1))
        if not (DIST / "posts" / slug / "index.html").is_file():
            missing_posts.append(slug)
ok_all &= add("url_parity", not missing_posts, missing=missing_posts)

# asset_size_budget
too_big = []
for p in DIST.rglob("*"):
    if p.is_file() and p.stat().st_size > MAX_ASSET_BYTES:
        too_big.append(str(p.relative_to(DIST)))
ok_all &= add("asset_size_budget", not too_big, max_bytes=MAX_ASSET_BYTES, offenders=too_big)

# secret_scan (cheap): private key headers anywhere in the artifact
secret_re = re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")
leaks = []
for p in DIST.rglob("*"):
    if p.is_file() and p.suffix.lower() in {".html", ".js", ".json", ".txt", ".xml", ".css"}:
        try:
            if secret_re.search(p.read_text(encoding="utf-8", errors="ignore")):
                leaks.append(str(p.relative_to(DIST)))
        except Exception:
            pass
ok_all &= add("secret_scan", not leaks, offenders=leaks)

report = {"status": "passed" if ok_all else "failed", "checks": checks}
(REPO / "verification.json").write_text(json.dumps(report, indent=2) + "\n")
print(json.dumps(report, indent=2))
sys.exit(0 if ok_all else 1)
