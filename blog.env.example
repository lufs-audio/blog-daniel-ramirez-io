# blog.env.example — the ONE shared config for the blog tooling.
#
# Copy to blog.env (gitignored) and point BLOG_SOURCE at your Obsidian vault's
# content folder:
#     cp blog.env.example blog.env
#
# Both sync_obsidian-to-astro.sh and scripts/new-post.mjs read blog.env. A
# pre-set BLOG_SOURCE environment variable OVERRIDES the file (CI / automation /
# other machines):  BLOG_SOURCE=/path npm run new-post -- --title "…"
#
# Plain KEY=VALUE (no shell expansion) so bash and Node parse it identically.
BLOG_SOURCE=/absolute/path/to/your/obsidian/hugo-content
