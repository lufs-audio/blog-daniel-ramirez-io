---
import { getEntry, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

const entry = await getEntry('pages', 'about/about');
if (!entry) throw new Error('about/about content entry not found');
const { Content } = await render(entry);
---

<PostLayout title={entry.data.title} date={entry.data.date} contentClass="about-lead" backdrop={true}>
  <Content />
</PostLayout>
