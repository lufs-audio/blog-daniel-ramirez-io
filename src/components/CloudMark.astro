---
/**
 * CloudMark — the family cloud mascot, animated (float + blink), pulled verbatim
 * from the resume site (lufs-dev.exe.xyz). The personal "Daniel Ramirez." mark;
 * lives in the site footer. Animation lives in tokens.css (@keyframes cloudFloat
 * / cloudBlink; honors prefers-reduced-motion). Accepts an optional class hook.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['cloud-mark', className]} aria-hidden="true">
  <svg class="logo-cloud" viewBox="0 0 200 200" aria-label="Daniel Ramirez — cloud mark">
    <path
      d="M100,30 C130,30 150,50 150,80 C180,80 200,100 200,130 C200,160 180,180 150,180 L50,180 C20,180 0,160 0,130 C0,100 20,80 50,80 C50,50 70,30 100,30 Z"
      fill="#e8e4d4"
      stroke="#201e1b"
      stroke-width="5"
      stroke-opacity="0.3"
    />
    <circle class="eye" cx="70" cy="100" r="15" fill="#201e1b"></circle>
    <circle class="eye" cx="130" cy="100" r="15" fill="#201e1b"></circle>
  </svg>
</span>
