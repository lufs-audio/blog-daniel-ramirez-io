---
/**
 * PostCard — one post in the lane. Card design unified with the resume site
 * (resume.daniel-ramirez.io): bg-alt surface, hairline border, hover lift + accent
 * border, Space-Mono kicker, pill tags. Reads only fields already in the
 * content schema (title/date/description/tags) — no schema change.
 */
import { hugoSlug } from '../lib/slug';

interface Props {
  post: {
    data: { title: string; date: Date; description?: string; tags?: string[] };
  };
  index: number;
}
const { post, index } = Astro.props;
const { title, date, description, tags = [] } = post.data;
const href = `/posts/${hugoSlug(title)}/`;
const kicker = `·/ ${String(index + 1).padStart(2, '0')}`;
const dateISO = date.toISOString().slice(0, 10);
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<li class="post-list__item reveal">
  <span class="post-list__k">{kicker}</span>
  <a class="post-list__link" href={href} data-hover>{title}</a>
  {description && <p class="post-list__desc">{description}</p>}
  <div class="post-list__meta">
    <time datetime={dateISO}>{dateLabel}</time>
    {tags.length > 0 && (
      <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
    )}
  </div>
</li>
