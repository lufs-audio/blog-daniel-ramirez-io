---
/**
 * Swarm — the house particle-life process. ONE engine, two presets, two variants.
 *
 * The process is the `swarm` entry from the ALife study banked in
 * `amacher-visual-process` (references/alife-study; Mohr formulation,
 * reimplemented from the published description, no GPL code taken).
 *
 * PRESETS (`process`) — the interaction matrix, and nothing else:
 *   membrane — strong self-attract, cross-repel → discrete cells with walls.
 *              The default, and the right verb for a page you scan: the process
 *              holds its edges the way the grid below it does.
 *   chain    — i chases i+1 → a directed cycle, streaming filaments. Louder;
 *              belongs on a hub, not on a page you read.
 *
 * VARIANTS (`variant`) — how loud it is, and nothing else:
 *   band  — the masthead strip. Dots sized to the band, full presence.
 *   field — a page-wide ambient ground. Sparser, smaller dots, and veiled by
 *           CSS so prose stays comfortably above 4.5:1.
 *
 * House rules this holds to:
 *  - Colour is a token, not a literal: the four type colours come from
 *    --viz-1..--viz-4, re-read when the dark/light switch flips, so the process
 *    repaints with the theme instead of fighting it.
 *  - Seeded (4021 by default): every visitor gets the same opening signature.
 *  - `step` is pure and draws nothing; `draw` never mutates state. Hover is a
 *    draw-only gain, so pointing at the band cannot perturb the process.
 *  - prefers-reduced-motion: warm it up, paint one still frame, stop.
 *  - Off-screen: paused.
 *
 * GEOMETRY. The torus is measured in SHORT-SIDE units: extents are
 * (w/min(w,h)) x (h/min(w,h)), so one extent is always exactly 1 and rMax means
 * the same physical distance whether the canvas is a wide band or a portrait
 * viewport. For a band (w > h) that is identical to the old height-unit torus —
 * the masthead renders bit-for-bit as before — but it also lets the field
 * variant run on a tall phone screen without cells swelling to half the width.
 */
interface Props {
  process?: 'membrane' | 'chain';
  variant?: 'band' | 'field';
  seed?: number;
  /** Extra classes on the canvas (e.g. the masthead's own positioning hook). */
  class?: string;
}
const { process = 'membrane', variant = 'band', seed = 4021, class: klass } = Astro.props;
---

<canvas
  class:list={['swarm', `swarm--${variant}`, klass]}
  data-swarm
  data-process={process}
  data-variant={variant}
  data-seed={String(seed)}
  aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    /* Bind to the canvas immediately before this script — instance-safe, so two
       swarms can share a page without either grabbing the other's element. */
    var self = document.currentScript;
    var cv = self && self.previousElementSibling;
    if (!cv || cv.tagName !== 'CANVAS') cv = document.querySelector('canvas[data-swarm]');
    if (!cv || cv.dataset.swarmOn) return;
    cv.dataset.swarmOn = '1';

    var ctx = cv.getContext('2d'); if (!ctx) return;
    var root = document.documentElement;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    var mode = cv.getAttribute('data-process') === 'chain' ? 'chain' : 'membrane';
    var field = cv.getAttribute('data-variant') === 'field';
    var seed = parseInt(cv.getAttribute('data-seed'), 10) || 4021;

    /* process constants */
    var NT = 4;                          // four types: gold leads, three seasonings
    var WEIGHT = [0.4, 0.2, 0.2, 0.2];   // single-accent discipline, as a population
    var beta = 0.3, rMax = 0.26, tHalf = 0.045, force = 5.2, dt = 1 / 60;

    var DPR = 1, W = 1, H = 1, U = 1, EX = 2.4, EY = 1;
    var px, py, vx, vy, tp, M, COUNT = 0;
    var running = true, over = false, eng = 0;
    var PAL = ['#d9a23d', '#e0836a', '#9fc1d0', '#a9a77f'];
    var GX = 3, GY = 3, OX = [-1, 0, 1], OY = [-1, 0, 1], cellHead = null, cellNext = null;

    function mulberry32(a) {
      return function () {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        var t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function palette() {
      var cs = getComputedStyle(root), out = [];
      for (var i = 1; i <= NT; i++) {
        var v = (cs.getPropertyValue('--viz-' + i) || '').trim();
        out.push(v || PAL[i - 1]);
      }
      PAL = out;
    }

    function size() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      var r = cv.getBoundingClientRect();
      var w = Math.max(1, r.width), h = Math.max(1, r.height);
      cv.width = Math.round(w * DPR); cv.height = Math.round(h * DPR);
      W = cv.width; H = cv.height; U = Math.min(W, H);
      var pEX = EX, pEY = EY, s = Math.min(w, h);
      EX = w / s; EY = h / s;
      GX = Math.max(1, Math.floor(EX / rMax));
      GY = Math.max(1, Math.floor(EY / rMax));
      /* With fewer than three cells on an axis the ±1 sweep would visit the same
         cell twice and double-count the force — one pass covers the axis. */
      OX = GX < 3 ? [0] : [-1, 0, 1];
      OY = GY < 3 ? [0] : [-1, 0, 1];
      cellHead = new Int32Array(GX * GY);
      // keep the structure across a resize: stretch the domain, don't reseed
      if (px && (Math.abs(EX - pEX) > 0.01 || Math.abs(EY - pEY) > 0.01)) {
        var kx = EX / pEX, ky = EY / pEY;
        for (var i = 0; i < COUNT; i++) {
          px[i] *= kx; if (px[i] >= EX) px[i] -= EX * Math.floor(px[i] / EX);
          py[i] *= ky; if (py[i] >= EY) py[i] -= EY * Math.floor(py[i] / EY);
        }
      }
    }

    function reset() {
      var r = mulberry32(seed), i;
      M = new Float32Array(NT * NT);
      var a, b;
      if (mode === 'chain') {
        for (a = 0; a < NT; a++) for (b = 0; b < NT; b++) {
          M[a * NT + b] = b === (a + 1) % NT ? 0.9 : a === b ? 0.32 : -0.18 + (r() * 0.14 - 0.07);
        }
      } else {
        for (a = 0; a < NT; a++) for (b = 0; b < NT; b++) {
          M[a * NT + b] = a === b ? 0.95 : -0.62 + r() * 0.5;
        }
      }
      var narrow = W / DPR < 820, area = EX * EY;
      /* Population is per unit AREA, so density reads the same at any shape.
         The field runs thinner than the band on purpose — it is a ground, not
         a subject, and it has prose sitting on top of it. */
      var dens = field ? 190 : (narrow ? 165 : 200);
      var cap = field ? 460 : (narrow ? 340 : 800);
      var min = field ? 150 : 165;
      COUNT = Math.max(min, Math.min(cap, Math.round(area * dens)));
      px = new Float32Array(COUNT); py = new Float32Array(COUNT);
      vx = new Float32Array(COUNT); vy = new Float32Array(COUNT);
      tp = new Uint8Array(COUNT); cellNext = new Int32Array(COUNT);
      var cum = [], acc = 0, k;
      for (i = 0; i < NT; i++) { acc += WEIGHT[i]; cum.push(acc); }
      for (i = 0; i < COUNT; i++) {
        px[i] = r() * EX; py[i] = r() * EY;
        vx[i] = 0; vy[i] = 0;
        var u = r() * acc; k = 0; while (k < NT - 1 && u > cum[k]) k++;
        tp[i] = k;
      }
    }

    function fRule(r, a) {
      if (r < beta) return r / beta - 1;
      if (r < 1) return a * (1 - Math.abs(2 * r - 1 - beta) / (1 - beta));
      return 0;
    }

    /* pure: reads state, writes state, draws nothing */
    function step() {
      cellHead.fill(-1);
      var i, cw = EX / GX, ch = EY / GY;
      for (i = 0; i < COUNT; i++) {
        var gx = Math.min(GX - 1, (px[i] / cw) | 0), gy = Math.min(GY - 1, (py[i] / ch) | 0);
        var c = gy * GX + gx; cellNext[i] = cellHead[c]; cellHead[c] = i;
      }
      var mu = Math.pow(0.5, dt / tHalf), halfX = EX / 2, halfY = EY / 2;
      for (i = 0; i < COUNT; i++) {
        var fx = 0, fy = 0;
        var gx2 = Math.min(GX - 1, (px[i] / cw) | 0), gy2 = Math.min(GY - 1, (py[i] / ch) | 0);
        for (var oyi = 0; oyi < OY.length; oyi++) {
          for (var oxi = 0; oxi < OX.length; oxi++) {
            var cgx = (gx2 + OX[oxi] + GX) % GX, cgy = (gy2 + OY[oyi] + GY) % GY;
            for (var j = cellHead[cgy * GX + cgx]; j !== -1; j = cellNext[j]) {
              if (j === i) continue;
              var dx = px[j] - px[i]; if (dx > halfX) dx -= EX; else if (dx < -halfX) dx += EX;
              var dy = py[j] - py[i]; if (dy > halfY) dy -= EY; else if (dy < -halfY) dy += EY;
              var d = Math.sqrt(dx * dx + dy * dy);
              if (d <= 0 || d >= rMax) continue;
              var f = fRule(d / rMax, M[tp[i] * NT + tp[j]]);
              fx += (dx / d) * f; fy += (dy / d) * f;
            }
          }
        }
        vx[i] = vx[i] * mu + fx * rMax * force * dt;
        vy[i] = vy[i] * mu + fy * rMax * force * dt;
      }
      for (i = 0; i < COUNT; i++) {
        px[i] += vx[i] * dt; py[i] += vy[i] * dt;
        if (px[i] < 0) px[i] += EX; else if (px[i] >= EX) px[i] -= EX;
        if (py[i] < 0) py[i] += EY; else if (py[i] >= EY) py[i] -= EY;
      }
    }

    /* read-only. `chain` gets a short velocity streak so the pursuit reads as
       direction; `membrane` gets a larger dot so the cell walls read as surfaces. */
    function draw() {
      var chain = mode === 'chain';
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, W, H);
      /* The band sizes its dot to the band, so the cell walls read as surfaces.
         The field wants one constant physical dot at any screen size — a texture,
         not a subject — so it is stated in CSS pixels and scaled by DPR. */
      var rad = field
        ? 1.9 * DPR
        : Math.max(1.1 * DPR, U / (chain ? 200 : 155)) * (1 + eng * 0.3);
      var trail = chain && !field ? dt * 10 : 0, maxLen = rad * 9;
      for (var t = 0; t < NT; t++) {
        ctx.fillStyle = PAL[t];
        ctx.strokeStyle = PAL[t];
        if (trail) {
          ctx.globalAlpha = 0.16 + eng * 0.14;
          ctx.lineWidth = Math.max(1, rad * 0.7);
          ctx.lineCap = 'round';
          ctx.beginPath();
          for (var j = 0; j < COUNT; j++) {
            if (tp[j] !== t) continue;
            var sx = px[j] * U, sy = py[j] * U;
            var dxs = -vx[j] * U * trail, dys = -vy[j] * U * trail;
            var len = Math.sqrt(dxs * dxs + dys * dys);
            if (len < 0.4) continue;
            if (len > maxLen) { var k2 = maxLen / len; dxs *= k2; dys *= k2; }
            ctx.moveTo(sx, sy); ctx.lineTo(sx + dxs, sy + dys);
          }
          ctx.stroke();
        }
        ctx.globalAlpha = (chain ? 0.68 : 0.76) + eng * 0.24;
        ctx.beginPath();
        for (var i = 0; i < COUNT; i++) {
          if (tp[i] !== t) continue;
          var x = px[i] * U, y = py[i] * U;
          ctx.moveTo(x + rad, y);
          ctx.arc(x, y, rad, 0, 6.2832);
        }
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function warm(n) { for (var i = 0; i < n; i++) step(); }

    /* BOOT GATE. This script sits immediately after its own canvas, so at parse
       time the band's content box does not exist yet and the canvas measures ~0
       tall — seeding off that gives a one-pixel backing store stretched over the
       real band, i.e. vertical stripes. Wait for a real box (and re-measure when
       it changes: the webfonts land after first paint, and mobile URL bars
       resize the viewport under a fixed field). */
    var booted = false, rt;
    function boot() {
      if (booted) return;
      var r = cv.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return;
      booted = true;
      try {
        palette(); size(); reset();
        if (reduce) { warm(260); draw(); }
        else {
          warm(220);
          (function loop() {
            if (running) { eng += ((over ? 1 : 0) - eng) * 0.07; step(); draw(); }
            requestAnimationFrame(loop);
          })();
        }
      } catch (e) { booted = false; }
    }
    function onBox() {
      if (!booted) { boot(); return; }
      clearTimeout(rt);
      rt = setTimeout(function () { try { size(); if (reduce) draw(); } catch (e) {} }, 180);
    }

    try { new ResizeObserver(onBox).observe(cv); } catch (e) {}
    window.addEventListener('resize', onBox);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    setTimeout(boot, 400); // belt and braces: never leave the band blank

    try {
      new IntersectionObserver(function (es) { running = es[0].isIntersecting; }, { threshold: 0.01 }).observe(cv);
    } catch (e) {}

    try {
      new MutationObserver(function () { palette(); if (reduce) draw(); })
        .observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    } catch (e) {}

    if (!field) {
      cv.addEventListener('pointerenter', function () { over = true; });
      cv.addEventListener('pointerleave', function () { over = false; });
    }
  })();
</script>
