---
/**
 * BaseLayout — the page shell and site chrome (sidebar + nav + footer).
 * Identity data comes from src/config/site.ts; design tokens + components from
 * src/styles/tokens.css. Ciani wires the data; Amacher owns the presentation.
 */
import { site } from '../config/site';
import CloudMark from '../components/CloudMark.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** OG/schema type: 'article' for posts, 'website' for everything else. */
  type?: 'website' | 'article';
  /** Article publication date — drives article:published_time + JSON-LD datePublished. */
  publishedDate?: Date;
  /** Topical tags — become article:tag + JSON-LD keywords. */
  tags?: string[];
}
const {
  title,
  description = site.description,
  type = 'website',
  publishedDate,
  tags = [],
} = Astro.props;
const pageTitle = title === site.brand ? site.brand : `${title} · ${site.brand}`;
const year = new Date().getFullYear();

// Absolute URLs for the social/structured layer — crawlers and unfurlers require them.
const pageUrl = new URL(Astro.url.pathname, site.canonicalUrl).href;
const ogImage = new URL(site.ogImage, site.canonicalUrl).href;
const publishedISO = publishedDate ? publishedDate.toISOString() : undefined;

/**
 * JSON-LD. This is the machine-readable attribution layer: it's what lets search
 * engines and answer engines (Perplexity, ChatGPT search, Exa) state WHO wrote a
 * piece and WHEN with confidence — the single biggest GEO lever after having
 * clean, crawlable prose. BlogPosting on articles, Person on everything else.
 */
const author = { '@type': 'Person', name: site.author, url: site.authorUrl };
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        ...(publishedISO ? { datePublished: publishedISO, dateModified: publishedISO } : {}),
        author,
        publisher: author,
        mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
        url: pageUrl,
        image: ogImage,
        inLanguage: 'en-US',
        ...(tags.length ? { keywords: tags.join(', ') } : {}),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.brand,
        description,
        url: new URL('/', site.canonicalUrl).href,
        inLanguage: 'en-US',
        author,
        publisher: author,
      };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* anti-FOUC: resolve theme before first paint. Stored choice wins; else follow
         the visitor's browser preference, resolved to a concrete light|dark. */
      (function(){try{var v=localStorage.getItem('dr-theme');
        document.documentElement.setAttribute('data-theme',(v==='light'||v==='dark')?v:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));
      }catch(e){document.documentElement.setAttribute('data-theme','dark');}})();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- The lufs-vh mark is BOTH the favicon and the footer stamp — one file at two
         sizes, same as resume.daniel-ramirez.io and daniel-ramirez.io. While the mark
         is unrendered (site.ts → visualHash === null) the cloud data-URI stands in. -->
    <link rel="icon" type="image/svg+xml" href={site.visualHash?.mark ?? site.favicon} />
    <link rel="alternate" type="application/rss+xml" title={site.brand} href={site.feedUrl} />
    <link rel="canonical" href={pageUrl} />

    <!-- Attribution + crawl policy. `author` and explicit snippet limits are what
         answer engines lean on; max-snippet:-1 lets them quote enough to cite well. -->
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph: makes shared links unfurl with a title/description/image
         instead of rendering as a bare grey URL in Slack, Bluesky, LinkedIn. -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:image:alt" content={`${site.brand} — ${site.description}`} />
    {type === 'article' && publishedISO && (
      <meta property="article:published_time" content={publishedISO} />
    )}
    {type === 'article' && <meta property="article:author" content={site.authorUrl} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.brand} — ${site.description}`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Self-hosted, cookieless analytics (Umami on the homelab). do-not-track honoured.
         `is:inline` is REQUIRED: without it Astro treats this as a bundled module and
         drops the external src, silently shipping no tracker at all. -->
    <script
      is:inline
      defer
      src="https://umami.lufshq.com/script.js"
      data-website-id="08b33ed2-1562-4bfd-8957-f5fd8098a456"
      data-do-not-track="true"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600;700;800&family=Public+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cur-dot" aria-hidden="true"></div>
    <div class="cur-ring" aria-hidden="true"></div>
    <div class="source-scrim" id="scrim" aria-hidden="true"></div>

    <!-- two-stage circular dark/light toggle; Skyward glyphs (one committed SVG per mode) -->
    <button class="theme-btn" id="themeBtn" type="button" aria-label="Toggle colour theme" title="Toggle colour theme">
      <span class="ic ic-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M14.4 3.6 A5 5 0 1 0 14.4 13.2 A3.7 3.7 0 1 1 14.4 3.6 Z" fill="#d9a23d"/><path d="M3.4 20.6 C3.4 18 5.5 17 7.1 17.5 C7.7 15 10.3 14.8 11.5 16.3 C12.9 15.5 14.9 16.3 15 17.9 C16.9 17.7 18.3 19.1 17.9 20.6 Z" fill="#efece0"/></svg></span>
      <span class="ic ic-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.4" r="3" fill="#b07d1e"/><g stroke="#b07d1e" stroke-width="1.6"><line x1="12" y1="1.9" x2="12" y2="3.5"/><line x1="5.8" y1="8.4" x2="7.3" y2="8.4"/><line x1="18.2" y1="8.4" x2="16.7" y2="8.4"/><line x1="7.1" y1="3.5" x2="8.1" y2="4.5"/><line x1="16.9" y1="3.5" x2="15.9" y2="4.5"/></g><path d="M3.4 20.6 C3.4 18 5.5 17 7.1 17.5 C7.7 15 10.3 14.8 11.5 16.3 C12.9 15.5 14.9 16.3 15 17.9 C16.9 17.7 18.3 19.1 17.9 20.6 Z" fill="#23211d"/></svg></span>
    </button>

    <div class="app">
      <aside class="site-sidebar" id="sidebar">
        <!-- centered brand: name -> cloud mark -> tagline -->
        <a href="/" class="site-brand" data-hover>
          <span class="site-brand__name">{site.brand}<span class="dot">.</span></span>
          <span class="site-brand__mark">
            <img src={site.brandImage} alt={site.brand} width="96" height="96" />
          </span>
        </a>
        <p class="site-brand__tagline">{site.description}</p>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            {site.menu.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-hover
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer', 'data-ext': '' } : {})}
                >
                  {item.name}{item.external && <span>↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <ul class="site-socials" id="socials">
          {site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" data-hover>{s.label}</a>
            </li>
          ))}
        </ul>
      </aside>

      <main class="site-main">
        <slot />
        <footer class="site-footer">
          <CloudMark />
          {/* copy grouped so it wraps as a unit and can't get squished against the stamp */}
          <div class="foot-txt">
            <a href="https://daniel-ramirez.io" target="_blank" rel="noopener noreferrer">Daniel Ramirez</a>
            <small>© {year} LUFS Audio</small>
          </div>
          {/* lufs-vh stamp, bottom-right. Same file as the favicon. Deliberately NOT a
              link — it's a seal, not navigation. See site.ts for how to re-derive it. */}
          {site.visualHash && (
            <img
              class="vh-mark"
              src={site.visualHash.mark}
              alt={site.visualHash.alt}
              title={site.visualHash.alt}
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
            />
          )}
        </footer>
      </main>
    </div>

    <script is:inline>
      (function () {
        // custom uniform cursor (hidden on touch)
        var d = document.querySelector('.cur-dot'), r = document.querySelector('.cur-ring');
        if (d && r && !(('ontouchstart' in window) || navigator.maxTouchPoints > 0)) {
          var mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
          addEventListener('mousemove', function (e) { mx = e.clientX; my = e.clientY; d.style.transform = 'translate(' + mx + 'px,' + my + 'px) translate(-50%,-50%)'; }, { passive: true });
          (function l() { rx += (mx - rx) * .18; ry += (my - ry) * .18; r.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)'; requestAnimationFrame(l); })();
          addEventListener('mouseover', function (e) { if (e.target.closest('a,button,[data-hover]')) r.classList.add('hot'); });
          addEventListener('mouseout', function (e) { if (e.target.closest('a,button,[data-hover]')) r.classList.remove('hot'); });
        } else if (d && r) { d.style.display = r.style.display = 'none'; }

        // scroll reveal, with a force-show fallback so content is never stuck hidden
        var els = document.querySelectorAll('.reveal');
        if (els.length) {
          var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: .08 });
          els.forEach(function (el) { io.observe(el); });
          setTimeout(function () { els.forEach(function (el) { el.classList.add('in'); }); }, 1000);
        }

        // mobile: relocate socials from the top bar to the bottom of the page
        var socials = document.getElementById('socials'), sidebar = document.getElementById('sidebar');
        function placeSocials() {
          if (!socials || !sidebar) return;
          if (matchMedia('(max-width:820px)').matches) {
            if (socials.parentElement !== document.body) { document.body.appendChild(socials); socials.classList.add('socials--bottom'); }
          } else {
            if (socials.parentElement !== sidebar) { sidebar.appendChild(socials); socials.classList.remove('socials--bottom'); }
          }
        }
        placeSocials();
        var rz; addEventListener('resize', function () { clearTimeout(rz); rz = setTimeout(placeSocials, 150); });
      })();
    </script>
    <script is:inline>
      (function(){var root=document.documentElement,b=document.getElementById('themeBtn');if(!b)return;
        function label(){var d=root.getAttribute('data-theme')==='dark';b.title=d?'Dark — switch to light':'Light — switch to dark';b.setAttribute('aria-label',b.title);}
        label();
        b.addEventListener('click',function(){var next=root.getAttribute('data-theme')==='dark'?'light':'dark';root.setAttribute('data-theme',next);try{localStorage.setItem('dr-theme',next);}catch(e){}label();});
      })();
    </script>
  </body>
</html>
