---
/**
 * BaseLayout — the page shell and site chrome (sidebar + nav + footer).
 * Identity data comes from src/config/site.ts; design tokens + components from
 * src/styles/tokens.css. Ciani wires the data; Amacher owns the presentation.
 */
import { site } from '../config/site';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title === site.brand ? site.brand : `${title} · ${site.brand}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    <link rel="alternate" type="application/rss+xml" title={site.brand} href={site.feedUrl} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.canonicalUrl)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600;700;800&family=Public+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cur-dot" aria-hidden="true"></div>
    <div class="cur-ring" aria-hidden="true"></div>
    <div class="source-scrim" id="scrim" aria-hidden="true"></div>

    <div class="app">
      <aside class="site-sidebar" id="sidebar">
        <!-- centered brand: name -> cloud mark -> tagline -->
        <a href="/" class="site-brand" data-hover>
          <span class="site-brand__name">{site.brand}<span class="dot">.</span></span>
          <span class="site-brand__mark">
            <img src={site.brandImage} alt={site.brand} width="96" height="96" />
          </span>
        </a>
        <p class="site-brand__tagline">{site.description}</p>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            {site.menu.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-hover
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer', 'data-ext': '' } : {})}
                >
                  {item.name}{item.external && <span>↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <ul class="site-socials" id="socials">
          {site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" data-hover>{s.label}</a>
            </li>
          ))}
        </ul>
      </aside>

      <main class="site-main">
        <slot />
        <footer class="site-footer">
          <span class="squares" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <a href="https://daniel-ramirez.io" target="_blank" rel="noopener noreferrer">Daniel Ramirez</a>
          <small>© {year} LUFS Audio</small>
        </footer>
      </main>
    </div>

    <script is:inline>
      (function () {
        // custom uniform cursor (hidden on touch)
        var d = document.querySelector('.cur-dot'), r = document.querySelector('.cur-ring');
        if (d && r && !(('ontouchstart' in window) || navigator.maxTouchPoints > 0)) {
          var mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
          addEventListener('mousemove', function (e) { mx = e.clientX; my = e.clientY; d.style.transform = 'translate(' + mx + 'px,' + my + 'px) translate(-50%,-50%)'; }, { passive: true });
          (function l() { rx += (mx - rx) * .18; ry += (my - ry) * .18; r.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)'; requestAnimationFrame(l); })();
          addEventListener('mouseover', function (e) { if (e.target.closest('a,button,[data-hover]')) r.classList.add('hot'); });
          addEventListener('mouseout', function (e) { if (e.target.closest('a,button,[data-hover]')) r.classList.remove('hot'); });
        } else if (d && r) { d.style.display = r.style.display = 'none'; }

        // scroll reveal, with a force-show fallback so content is never stuck hidden
        var els = document.querySelectorAll('.reveal');
        if (els.length) {
          var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: .08 });
          els.forEach(function (el) { io.observe(el); });
          setTimeout(function () { els.forEach(function (el) { el.classList.add('in'); }); }, 1000);
        }

        // mobile: relocate socials from the top bar to the bottom of the page
        var socials = document.getElementById('socials'), sidebar = document.getElementById('sidebar');
        function placeSocials() {
          if (!socials || !sidebar) return;
          if (matchMedia('(max-width:820px)').matches) {
            if (socials.parentElement !== document.body) { document.body.appendChild(socials); socials.classList.add('socials--bottom'); }
          } else {
            if (socials.parentElement !== sidebar) { sidebar.appendChild(socials); socials.classList.remove('socials--bottom'); }
          }
        }
        placeSocials();
        var rz; addEventListener('resize', function () { clearTimeout(rz); rz = setTimeout(placeSocials, 150); });
      })();
    </script>
  </body>
</html>
